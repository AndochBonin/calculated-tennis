# Copy to moneymanager/.env (or set in the shell). Loaded by cmd/server and cmd/checkbalance
# via internal/env.Load() (also tries ../polymarket/.env as a fallback).
#
# Required for: server = moneymanager gRPC service; balance = checkbalance CLI only.

# --- Signing (server only; required) ---
# Hex private key for EIP-712 order signing. Use one of:
POLYMARKET_PRIVATE_KEY=
# METAMASK_KEY=

# --- Polymarket funder (server + checkbalance; required) ---
# Proxy/deposit wallet that holds USDC collateral. Use one of:
POLYMARKET_DEPOSIT_WALLET=
# DEPOSIT_WALLET=

# --- Polygon RPC (server + checkbalance) ---
# Polygon PoS JSON-RPC (chain 137) for USDC balance reads.
# Default if unset: https://polygon.drpc.org
#
# https://cloudflare-eth.com is Cloudflare's Ethereum mainnet gateway only — not Polygon.
# Public Polygon endpoints: https://docs.polygon.technology/pos/reference/rpc-endpoints/
POLYGON_RPC_URL=https://polygon.drpc.org

# --- gRPC (server listen / polymarket client dial) ---
# Server bind address. Default: 127.0.0.1:50051
MONEYMANAGER_GRPC_ADDR=127.0.0.1:50051

# --- Risk allocation (server only; ProcessSignal) ---
# Optional absolute USDC cap per signal (empty = no cap).
MONEYMANAGER_MAX_ORDER_USDC=

# Fraction of live USDC balance to allocate per BUY signal. Default: 0.05 (5%).

MONEYMANAGER_MAX_PCT_BALANCE=0.05

# Minimum share size after allocation. Default: 5
MONEYMANAGER_MIN_SHARE_SIZE=5

# --- CLOB signing (server only) ---
# Polymarket signature type 0–3. Default: 3 (POLY_1271).
POLYMARKET_CLOB_SIGNATURE_TYPE=3

# --- AWS Secrets Manager (optional) ---
# If set, loads a JSON object from Secrets Manager into the process environment
# before startup (keys become env vars). Useful for production; requires AWS credentials.
# Example secret JSON keys: POLYMARKET_PRIVATE_KEY, POLYMARKET_DEPOSIT_WALLET, POLYGON_RPC_URL, …
# POLYMARKET_SECRETS_MANAGER_SECRET_ID=
