# Tennis module environment. Copy to .env (gitignored) and adjust.
# The TUI and cmd/* load this via godotenv when run from the tennis/ dir.

# --- Projection alpha (sensitivity) -----------------------------------------
# Alpha is no longer entered in the TUI; it is resolved per surface here.
# Resolution order: surface-specific override -> global -> code default (1.0).
# Must be > 0. Lower = more lopsided (better player dominates); higher = closer.
TENNISABSTRACT_ALPHA=1.0
TENNISABSTRACT_ALPHA_HARD=1.0
TENNISABSTRACT_ALPHA_CLAY=1.3
TENNISABSTRACT_ALPHA_GRASS=0.7

# --- Redis cache (optional) -------------------------------------------------
# Either REDIS_URL or REDIS_ADDR enables the Tennis Abstract rate cache.
# REDIS_URL=redis://localhost:6379/0
# REDIS_ADDR=localhost:6379
# TENNISABSTRACT_CACHE_TTL=24h

# --- Surface-specific form tuning (optional) --------------------------------
# Each falls back to its global key, then to code defaults in form.go.
# Suffix with _HARD / _CLAY / _GRASS for per-surface overrides.
# TENNISABSTRACT_FORM_HALF_LIFE_MATCHES=5.0
# TENNISABSTRACT_FORM_WEIGHT_MAX=0.30
# TENNISABSTRACT_FORM_RATIO_MIN=0.92
# TENNISABSTRACT_FORM_RATIO_MAX=1.08
